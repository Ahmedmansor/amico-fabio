---
import MarketingConsentCard from '../../src/features/marketing/presentation/MarketingConsentCard.astro';
import {getMarketingMessages} from '../../src/features/marketing/data/messages';
import type {Locale} from '../../src/shared/config/languages';
import {supportedLocales} from '../../src/shared/config/languages';
import {siteConfig} from '../../src/shared/config/site';
import '../../src/shared/styles/global.css';
import '../../src/shared/styles/theme.css';
import '../../src/shared/styles/typography.css';
interface Props {locale:Locale}
const {locale}=Astro.props,m=getMarketingMessages(locale);
const labels=locale==='it'?{title:'Anteprima delle preferenze email',note:'Solo anteprima del design. Nessun account, consenso o invio email viene creato.',ready:'Non selezionato',checked:'Selezionato',loading:'Caricamento',failed:'Errore',verify:'Email da verificare',submit:'Solo anteprima: nessuna preferenza è stata salvata.'}:{title:'Email preferences preview',note:'Design preview only. No account, consent or email is created.',ready:'Unchecked',checked:'Checked',loading:'Loading',failed:'Error',verify:'Unverified email',submit:'Preview only: no preference has been saved.'};
---
<!doctype html><html lang={locale}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>{labels.title}</title><meta name="description" content={labels.note}/><link rel="canonical" href={new URL(`/${locale}/qa-marketing-card/`,siteConfig.url).href}/>{supportedLocales.map(code=><link rel="alternate" hreflang={code} href={new URL(`/${code}/qa-marketing-card/`,siteConfig.url).href}/>)}</head>
<body class="marketing-preview"><main><h1>{labels.title}</h1><p class="qa-note">{labels.note}</p><nav class="qa-states" aria-label={labels.title}>{(['ready','checked','loading','failed','verify'] as const).map(state=><button type="button" data-qa-state={state}>{labels[state]}</button>)}</nav><MarketingConsentCard locale={locale}/></main>
<script id="qa-design-copy" type="application/json" set:html={JSON.stringify({m,labels}).replaceAll('<','\u003c')}/>
<script>
 const root=document.querySelector<HTMLElement>('[data-marketing-consent]')!,choice=root.querySelector<HTMLInputElement>('[data-marketing-choice]')!,save=root.querySelector<HTMLButtonElement>('[data-marketing-save]')!,status=root.querySelector<HTMLElement>('[data-marketing-status]')!,retry=root.querySelector<HTMLButtonElement>('[data-marketing-retry]')!;
 const {m,labels}=JSON.parse(document.getElementById('qa-design-copy')!.textContent!);
 root.hidden=false;choice.disabled=false;save.disabled=false;status.textContent='';
 function show(state:string){const locked=['loading','failed','verify'].includes(state);choice.disabled=locked;save.disabled=locked;choice.checked=state==='checked';retry.hidden=state!=='failed';status.textContent=state==='loading'?m.loading:state==='failed'?m.failed:state==='verify'?m.verify:'';}
 document.querySelectorAll<HTMLButtonElement>('[data-qa-state]').forEach(button=>button.addEventListener('click',()=>show(button.dataset.qaState!)));
 retry.addEventListener('click',()=>show('ready'));
 root.querySelector('form')!.addEventListener('submit',event=>{event.preventDefault();status.textContent=labels.submit;});
</script>
<style is:global>
 .marketing-preview{margin:0;background:var(--bg-tinted);color:var(--text-main);font-family:Montserrat,Arial,sans-serif}.marketing-preview *{box-sizing:border-box}.marketing-preview main{width:min(960px,calc(100% - 32px));margin:40px auto}.marketing-preview h1{font:600 22px/1.4 Montserrat,Arial,sans-serif;color:var(--color-primary);margin:0 0 12px}.qa-note{font-size:13px;line-height:1.8;color:var(--text-secondary);max-width:75ch}.qa-states{display:flex;flex-wrap:wrap;gap:8px;margin:20px 0}.qa-states button{min-height:44px;padding:10px 14px;border:1px solid var(--border-color);border-radius:8px;background:var(--bg-white);color:var(--color-primary);font:500 12px Montserrat,Arial,sans-serif;cursor:pointer}
</style></body></html>
