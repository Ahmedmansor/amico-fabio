# Copy to .env.catalog for local builds (ignored by Git).
# On a build host, configure these as environment variables; no browser prefix.
CATALOG_PROVIDER=supabase
CATALOG_SUPABASE_URL=https://your-project.supabase.co
CATALOG_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_public_key
# Explicit rollback: CATALOG_PROVIDER=sheets. There is no automatic fallback.

# Browser Auth is a separate, opt-in integration. Do not copy catalog keys here.
# Keep disabled until provider/redirect/template and abuse protection are reviewed.
PUBLIC_AUTH_ENABLED=0
PUBLIC_AUTH_SUPABASE_URL=
PUBLIC_AUTH_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_AUTH_SITE_URL=
PUBLIC_AUTH_GOOGLE_ENABLED=0
PUBLIC_AUTH_EMAIL_ENABLED=0
# Explicit approved cooldown, matching backend settings; no invented default.
PUBLIC_AUTH_RESEND_SECONDS=
