---
import BaseLayout from '../../../shared/layouts/BaseLayout.astro';
import PackagePage from '../../../features/packages/presentation/PackagePage.astro';
import {getPackagePages} from '../../../features/packages/data/details.mjs';
import {getAddons} from '../../../features/booking/data/addons.mjs';
import type {Locale} from '../../../shared/config/languages';
export async function getStaticPaths(){const [pages,addons]=await Promise.all([getPackagePages(),getAddons()]);return pages.map(page=>({params:{locale:page.locale,slug:page.package.slug},props:{page,addons:addons.filter(addon=>addon.tripId===page.package.id)}}));}
const {page,addons}=Astro.props,locale=page.locale as Locale;
---
<BaseLayout locale={locale} route={`packages/${page.package.slug}`} title={`Fabio Tours | ${page.text.title}`} description={page.text.short_desc.replace(/\s+/g,' ').trim().slice(0,200)} bodyClass="font-sans antialiased text-gray-200 package-details-page"><PackagePage page={page} addons={addons}/></BaseLayout>
