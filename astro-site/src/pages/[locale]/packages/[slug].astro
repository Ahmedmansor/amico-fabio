---
import BaseLayout from '../../../shared/layouts/BaseLayout.astro';
import CatalogStructuredData from '../../../shared/seo/CatalogStructuredData.astro';
import {catalogPlainText} from '../../../shared/domain/catalog-seo';
import PackagePage from '../../../features/packages/presentation/PackagePage.astro';
import {getPackagePages} from '../../../features/packages/data/details.mjs';
import {getAddons} from '../../../features/booking/data/addons.mjs';
import CatalogRedirect from '../../../shared/components/CatalogRedirect.astro';
import {catalogSlug,catalogPath,catalogAlternates} from '../../../shared/domain/catalog-routes';
import {supportedLocales} from '../../../shared/config/languages';
import type {Locale} from '../../../shared/config/languages';
import {getShareImage} from '../../../shared/seo/share-image';
import {imageAssets} from '../../../features/packages/presentation/images';
export async function getStaticPaths(){const [pages,addons]=await Promise.all([getPackagePages(),getAddons()]);return pages.flatMap(page=>{const slug=catalogSlug(page.package,page.locale),props={page,addons:addons.filter(addon=>addon.tripId===page.package.id),redirect:false};return [{params:{locale:page.locale,slug},props},...(slug===page.package.slug?[]:[{params:{locale:page.locale,slug:page.package.slug},props:{...props,redirect:true}}])];});}
const {page,addons,redirect}=Astro.props,locale=page.locale as Locale;
const slug=catalogSlug(page.package,locale);
const alternatePaths=catalogAlternates(page.package,supportedLocales,'packages');
const shareImage=await getShareImage(imageAssets[page.package.poster],page.text.title);
---
{redirect?<CatalogRedirect destination={catalogPath(page.package,locale,'packages')} title={catalogPlainText(page.text.title)} locale={locale} description={catalogPlainText(page.text.short_desc)} shareImage={shareImage}/>:<BaseLayout alternatePaths={alternatePaths} locale={locale} route={`packages/${slug}`} title={`${catalogPlainText(page.text.title)} | Fabio Egypt`} description={catalogPlainText(page.text.short_desc)} shareImage={shareImage} keywords={page.text.seo_tags.join(', ')} bodyClass="font-sans antialiased text-gray-200 package-details-page"><CatalogStructuredData slot="head-start" image={shareImage} product={{kind:'package',locale,slug,title:page.text.title,description:page.text.short_desc,adultPrice:page.package.prices.adult,program:page.text.program,included:page.included.map(item=>({slug:catalogSlug(item.trip,locale),title:item.text.title}))}}/><PackagePage page={page} addons={addons}/></BaseLayout>}
