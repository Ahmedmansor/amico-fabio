---
import {getBluCampaign} from '../../../features/blu/data/campaign';
import {getBluPrograms} from '../../../features/blu/data/programs';
import {bluLocales} from '../../../features/blu/domain/campaign';
import {getBluJourney} from '../../../features/blu/data/journey';
import BluPage from '../../../features/blu/presentation/BluPage.astro';
export async function getStaticPaths() {
 return Promise.all(bluLocales.map(async locale=>({params:{locale},props:{campaign:getBluCampaign(locale),programs:await getBluPrograms(locale),journey:await getBluJourney(locale)}})));
}
const {campaign,programs,journey}=Astro.props;
---
<BluPage campaign={campaign} programs={programs} journey={journey}/>
