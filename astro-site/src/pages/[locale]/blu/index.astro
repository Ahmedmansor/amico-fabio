---
import {getBluCampaign} from '../../../features/blu/data/campaign';
import {getBluRelatedTrips} from '../../../features/blu/data/related-trips';
import {bluLocales} from '../../../features/blu/domain/campaign';
import BluPage from '../../../features/blu/presentation/BluPage.astro';
export async function getStaticPaths() {
 return Promise.all(bluLocales.map(async locale=>({params:{locale},props:{campaign:getBluCampaign(locale),trips:await getBluRelatedTrips(locale)}})));
}
const {campaign,trips}=Astro.props;
---
<BluPage campaign={campaign} trips={trips}/>
