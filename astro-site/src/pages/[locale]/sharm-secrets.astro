---
import BaseLayout from '../../shared/layouts/BaseLayout.astro';
import SecretsPage from '../../features/sharm-secrets/presentation/SecretsPage.astro';
import {getGuidePage} from '../../features/sharm-secrets/data/secrets';
import {supportedLocales} from '../../shared/config/languages';
export function getStaticPaths(){return supportedLocales.map(locale=>({params:{locale},props:{locale,page:getGuidePage(locale)}}));}
const {locale,page}=Astro.props;
---
<BaseLayout locale={locale} route="sharm-secrets" title={page.seo.title} description={page.seo.description} bodyClass="sharm-secrets-page"><SecretsPage page={page}/></BaseLayout>
