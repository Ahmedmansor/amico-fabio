---
import BaseLayout from '../../../shared/layouts/BaseLayout.astro';
import CatalogStructuredData from '../../../shared/seo/CatalogStructuredData.astro';
import {catalogPlainText} from '../../../shared/domain/catalog-seo';
import TripPage from '../../../features/tours/presentation/TripPage.astro';
import {getTourPages} from '../../../features/tours/data/details.mjs';
import {getAddons} from '../../../features/booking/data/addons.mjs';
import type {Locale} from '../../../shared/config/languages';
import {getShareImage} from '../../../shared/seo/share-image';
import {imageAssets} from '../../../features/tours/presentation/images';
export async function getStaticPaths(){const [pages,addons]=await Promise.all([getTourPages(),getAddons()]);return pages.map(page=>({params:{locale:page.locale,slug:page.trip.slug},props:{page,addons:addons.filter(addon=>addon.tripId===page.trip.id)}}));}
const {page,addons}=Astro.props;const locale=page.locale as Locale;
const shareImage=await getShareImage(imageAssets[page.trip.poster],page.text.title);
---
<BaseLayout locale={locale} route={`tours/${page.trip.slug}`} title={`${catalogPlainText(page.text.title)} | Fabio Egypt`} description={catalogPlainText(page.text.short_desc)} shareImage={shareImage} keywords={page.text.seo_tags.join(', ')} bodyClass="font-sans antialiased text-gray-200 details-page"><CatalogStructuredData slot="head-start" image={shareImage} product={{kind:'tour',locale,slug:page.trip.slug,title:page.text.title,description:page.text.short_desc,adultPrice:page.trip.prices.adult,program:page.text.program}}/><TripPage page={page} addons={addons}/></BaseLayout>
