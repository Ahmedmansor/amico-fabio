---
import BaseLayout from '../../../shared/layouts/BaseLayout.astro';
import CatalogStructuredData from '../../../shared/seo/CatalogStructuredData.astro';
import {catalogPlainText} from '../../../shared/domain/catalog-seo';
import TripPage from '../../../features/tours/presentation/TripPage.astro';
import {getTourPages} from '../../../features/tours/data/details.mjs';
import {getAddons} from '../../../features/booking/data/addons.mjs';
import CatalogRedirect from '../../../shared/components/CatalogRedirect.astro';
import {catalogSlug,catalogPath,catalogAlternates} from '../../../shared/domain/catalog-routes';
import {supportedLocales} from '../../../shared/config/languages';
import type {Locale} from '../../../shared/config/languages';
import {getShareImage} from '../../../shared/seo/share-image';
import {imageAssets} from '../../../features/tours/presentation/images';
export async function getStaticPaths(){const [pages,addons]=await Promise.all([getTourPages(),getAddons()]);return pages.flatMap(page=>{const slug=catalogSlug(page.trip,page.locale),props={page,addons:addons.filter(addon=>addon.tripId===page.trip.id),redirect:false};return [{params:{locale:page.locale,slug},props},...(slug===page.trip.slug?[]:[{params:{locale:page.locale,slug:page.trip.slug},props:{...props,redirect:true}}])];});}
const {page,addons,redirect}=Astro.props;const locale=page.locale as Locale;
const slug=catalogSlug(page.trip,locale);
const alternatePaths=catalogAlternates(page.trip,supportedLocales,'tours');
const shareImage=await getShareImage(imageAssets[page.trip.poster],page.text.title);
---
{redirect?<CatalogRedirect destination={catalogPath(page.trip,locale,'tours')} title={catalogPlainText(page.text.title)} locale={locale} description={catalogPlainText(page.text.short_desc)} shareImage={shareImage}/>:<BaseLayout alternatePaths={alternatePaths} locale={locale} route={`tours/${slug}`} title={`${catalogPlainText(page.text.title)} | Fabio Egypt`} description={catalogPlainText(page.text.short_desc)} shareImage={shareImage} keywords={page.text.seo_tags.join(', ')} bodyClass="font-sans antialiased text-gray-200 details-page"><CatalogStructuredData slot="head-start" image={shareImage} product={{kind:'tour',locale,slug,title:page.text.title,description:page.text.short_desc,adultPrice:page.trip.prices.adult,program:page.text.program}}/><TripPage page={page} addons={addons}/></BaseLayout>}
