---
import '../styles/global.css';
import '../styles/legacy-shell.css';
import PageHead from '../seo/PageHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import DocumentShell from './DocumentShell.astro';
import type { Locale } from '../config/languages';
interface Props { locale: Locale; route: string; title: string; description: string; bodyClass?: string }
const { locale, route, title, description, bodyClass } = Astro.props;
---
<DocumentShell locale={locale} bodyClass={bodyClass}>
  <PageHead slot="head" locale={locale} route={route} title={title} description={description}/>
  <Header locale={locale} route={route}/><slot/><Footer locale={locale}/><WhatsAppFloat locale={locale}/>
</DocumentShell>
