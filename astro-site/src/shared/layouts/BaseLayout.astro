---
import '../styles/global.css';
import '../styles/legacy-shell.css';
import PageHead from '../seo/PageHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import DocumentShell from './DocumentShell.astro';
import type { Locale } from '../config/languages';
import type {ShareImage} from '../seo/share-image';
import AuthDialog from '../../features/auth/presentation/AuthDialog.astro';
import WishlistInvitation from '../../features/wishlist/presentation/WishlistInvitation.astro';
interface Props { locale: Locale; route: string; title: string; description: string; bodyClass?: string; shareImage?:ShareImage;keywords?:string;noindex?:boolean }
const { locale, route, title, description, bodyClass,shareImage,keywords,noindex=false } = Astro.props;
---
<DocumentShell locale={locale} bodyClass={bodyClass}>
  <Fragment slot="head"><slot name="head-start"/><PageHead locale={locale} route={route} title={title} description={description} shareImage={shareImage} keywords={keywords} noindexOverride={noindex}/></Fragment>
  <Header locale={locale} route={route}/><WishlistInvitation locale={locale}/><slot/><Footer locale={locale}/><WhatsAppFloat locale={locale}/>
  <AuthDialog locale={locale}/>
</DocumentShell>
