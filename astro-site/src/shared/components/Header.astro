---
import { Image } from 'astro:assets';
import logo from '../assets/logos/fabio-header-logo.webp';
import { languages, supportedLocales, type Locale } from '../config/languages';
import { getSharedMessages } from '../i18n/shared';
import WishlistLink from '../../features/wishlist/presentation/WishlistLink.astro';
import AuthTrigger from '../../features/auth/presentation/AuthTrigger.astro';
import { authConfig } from '../../features/auth/data/build-config';
interface Props { locale: Locale; route: string }
const { locale, route } = Astro.props;
const messages = getSharedMessages(locale);
const nav = [
  { key: 'home', label: messages.menu.home, href: `/${locale}/` },
  { key: 'trips', label: messages.menu.trips, href: `/${locale}/#trips-grid` },
  { key: 'reviews', label: messages.menu.reviews, href: `/${locale}/#reviews-section` },
  { key: 'secrets', label: messages.menu.commandments, href: `/${locale}/sharm-secrets/` },
  { key: 'blog', label: messages.menu.blog, href: '#' },
];
---
<header id="global-header" class="fixed w-full top-0 z-50" data-session-pending={authConfig ? 'true' : undefined}>
  <div id="scroll-progress"></div>
  <script is:inline>
    (function() {
      try {
        var header = document.getElementById('global-header');
        if (!header) return;
        var profileRaw = localStorage.getItem('fabio:auth:profile:v1');
        var profile = null;
        if (profileRaw) {
          try { profile = JSON.parse(profileRaw); } catch(e) {}
        }
        var hasSession = false;
        if (profile && profile.userId) {
          hasSession = true;
        } else {
          for (var i = 0; i < localStorage.length; i++) {
            var k = localStorage.key(i);
            if (k && k.indexOf('sb-') === 0 && k.indexOf('-auth-token') !== -1) {
              hasSession = true; break;
            }
          }
        }
        var trigger = header.querySelector('.auth-trigger');
        if (trigger) {
          if (profile && profile.displayName) {
            var nameParts = profile.displayName.trim().split(/\s+/);
            var firstName = nameParts[0] || profile.displayName;
            var labelEl = trigger.querySelector('.auth-trigger-label');
            var greetingTpl = trigger.getAttribute('data-greeting-tpl') || 'Ciao, {name}';
            var greeting = greetingTpl.replace('{name}', firstName);
            if (labelEl) labelEl.textContent = greeting;
            trigger.setAttribute('aria-label', greeting);
            var avatarWrap = trigger.querySelector('.auth-trigger-avatar');
            if (avatarWrap) {
              avatarWrap.setAttribute('data-avatar-loading', 'false');
              if (profile.avatarUrl) {
                var img = avatarWrap.querySelector('img');
                var fallback = avatarWrap.querySelector('[data-auth-avatar-fallback]');
                if (img) { img.src = profile.avatarUrl; img.hidden = false; }
                if (fallback) fallback.hidden = true;
              }
            }
            trigger.setAttribute('aria-busy', 'false');
            trigger.removeAttribute('disabled');
            header.removeAttribute('data-session-pending');
          } else if (!hasSession) {
            var labelEl = trigger.querySelector('.auth-trigger-label');
            var signInText = trigger.getAttribute('data-signin-label');
            if (labelEl && signInText) {
              labelEl.textContent = signInText;
              trigger.setAttribute('aria-label', signInText);
            }
            var avatarWrap = trigger.querySelector('.auth-trigger-avatar');
            if (avatarWrap) avatarWrap.setAttribute('data-avatar-loading', 'false');
            trigger.setAttribute('aria-busy', 'false');
            trigger.removeAttribute('disabled');
            header.removeAttribute('data-session-pending');
          }
        }
        var count = 0;
        if (profile && profile.userId) {
          var accRaw = localStorage.getItem('fabio:wishlist:account:' + encodeURIComponent(profile.userId) + ':v1');
          if (accRaw) {
            try {
              var acc = JSON.parse(accRaw);
              if (acc && Array.isArray(acc.ids)) count = acc.ids.length;
            } catch(e) {}
          }
        } else {
          for (var j = 0; j < localStorage.length; j++) {
            var key = localStorage.key(j);
            if (key && (key.indexOf('fabio:wishlist:v1:trip:') === 0 || key.indexOf('fabio:wishlist:v1:package:') === 0)) {
              count++;
            }
          }
        }
        var countEl = header.querySelector('[data-wishlist-count]');
        var linkEl = header.querySelector('[data-wishlist-link]');
        if (linkEl) {
          linkEl.setAttribute('data-wishlist-loading', 'false');
          linkEl.setAttribute('aria-busy', 'false');
          if (count > 0) {
            if (countEl) { countEl.textContent = String(count); countEl.hidden = false; }
            var countTpl = linkEl.getAttribute('data-count-label');
            if (countTpl) linkEl.setAttribute('aria-label', countTpl.replace('{count}', String(count)));
          } else {
            if (countEl) { countEl.textContent = ''; countEl.hidden = true; }
            var baseLabel = linkEl.getAttribute('data-base-label');
            if (baseLabel) linkEl.setAttribute('aria-label', baseLabel);
          }
          header.removeAttribute('data-session-pending');
        }
      } catch(e) {}
    })();
  </script>
  <div class="gh-container">
    <div class="gh-left">
      <AuthTrigger locale={locale}/>
      <button class="gh-menu-btn" id="gh-menu-btn" type="button" aria-label={messages.labels.menu} aria-expanded="false">
        <img src="/assets/images/icons/menu-icon.webp" alt={messages.labels.menu} />
        <svg class="gh-menu-fallback" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><rect x="3" y="5" width="18" height="2" fill="#fff"/><rect x="3" y="11" width="18" height="2" fill="#fff"/><rect x="3" y="17" width="18" height="2" fill="#fff"/></svg>
      </button>
      <div class="gh-dynamic-hook" id="gh-dynamic-hook"></div>
      <div class="gh-menu-dropdown" id="gh-menu-dropdown">{nav.map(item => <a href={item.href} data-nav={item.key}>{item.label}</a>)}</div>
    </div>
    <div class="gh-center" id="gh-center">
      <div class="gh-brand-wrap-center">
        <Image src={logo} class="gh-logo" alt={messages.labels.headerLogo} width={84} height={81} style="max-width:84px; max-height:81px;" />
        <div class="gh-brand"><div class="gh-brand-title">FABIO</div><div class="gh-brand-subtitle">{messages.global.brand_subtitle}</div></div>
      </div>
      <nav class="gh-nav-inline" id="gh-nav-inline">{nav.map(item => <a href={item.href} data-nav={item.key} class:list={{ active: (route === '' && item.key === 'home') || (route === 'sharm-secrets' && item.key === 'secrets') }}>{item.label}</a>)}</nav>
    </div>
    <div class="gh-right">
      <WishlistLink locale={locale} active={route === 'wishlist'}/>
      <button class="gh-lang-btn" id="gh-lang-btn" type="button" aria-label={languages[locale].label} aria-expanded="false">
        <img src={`/assets/images/icons/languages/${locale}.svg`} class="gh-flag-svg" alt=""/><span class="gh-chevron">▼</span>
      </button>
      <div class="gh-lang-dropdown" id="gh-lang-dropdown">{supportedLocales.map(language =>
        <a class:list={['gh-lang-item', { active: language === locale }]} data-lang={language} href={`/${language}/${route ? `${route}/` : ''}`} hreflang={language}>
          <img src={`/assets/images/icons/languages/${language}.svg`} class="gh-flag-svg" alt=""/><span>{languages[language].label}</span>
        </a>
      )}</div>
    </div>
  </div>
</header>
<script>
  import './header-interactions';
</script>
