---
import {Image} from 'astro:assets';
import portrait from '../assets/people/fabio.webp';
import './fabio-portrait.css';
---
<div class="fabio-portrait">
  <span class="fabio-portrait-orbit" aria-hidden="true"></span>
  <div class="fabio-portrait-photo"><Image src={portrait} alt="Fabio" widths={[180,360]} sizes="180px" loading="lazy" quality={75}/></div>
  <span class="fabio-portrait-badge" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></svg></span>
</div>
