---
import {Image,getImage} from 'astro:assets';
import type {ImageMetadata} from 'astro';
import type {Locale} from '../../config/languages';
import {getSharedMessages} from '../../i18n/shared';
interface Props {images:ImageMetadata[];title:string;locale:Locale}
const {images,title,locale}=Astro.props;
const m=getSharedMessages(locale).productDetail;
const plainTitle=title.replace(/<[^>]*>/g,'');
const previews=images.slice(0,5);
const optimized=await Promise.all(images.map(src=>getImage({src,width:Math.min(src.width,1400),format:'webp'})));
const label=(index:number)=>`${plainTitle} — ${m.photo.replace('{index}',String(index+1)).replace('{total}',String(images.length))}`;
---
<section class="product-gallery" aria-label={m.gallery}>
  <div class:list={['product-mosaic',`product-mosaic-${Math.min(images.length,5)}`]}>
    {previews.map((src,index)=><button class="product-photo" type="button" data-gallery-open={index} aria-label={label(index)}>
      <Image id={index===0?'hero-bg-img':undefined} src={src} alt={label(index)} widths={index===0?[600,1000,1400]:[320,600]} sizes={index===0?'(min-width:1024px) 620px, (min-width:768px) 65vw, 100vw':'(min-width:1024px) 300px, (min-width:768px) 33vw, 100vw'} loading={index===0?'eager':'lazy'} fetchpriority={index===0?'high':'auto'}/>
    </button>)}
  </div>
  <button class="product-all-photos" type="button" data-gallery-open="0"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="8" cy="8" r="1.5"/><path d="m3 17 6-6 4 4 3-3 5 5"/></svg>{m.showAllPhotos}<span>{images.length}</span></button>
</section>
<dialog class="product-gallery-dialog" data-product-gallery-dialog aria-label={m.gallery}>
  <div class="product-gallery-toolbar"><h2>{m.gallery}</h2><button type="button" data-gallery-close aria-label={m.closeGallery}><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg></button></div>
  <div class="product-lightbox-stage">
    <button class="product-lightbox-prev" type="button" data-gallery-prev aria-label={m.previousPhoto}><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m14 6-6 6 6 6"/></svg></button>
    <img data-lightbox-image src={optimized[0].src} width={optimized[0].attributes.width} height={optimized[0].attributes.height} loading="lazy" decoding="async" alt={label(0)}/>
    <button class="product-lightbox-next" type="button" data-gallery-next aria-label={m.nextPhoto}><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m10 6 6 6-6 6"/></svg></button>
  </div>
  <p class="product-lightbox-caption" data-gallery-caption aria-live="polite">{m.photo.replace('{index}','1').replace('{total}',String(images.length))}</p>
  <div class="product-gallery-thumbs">{images.map((src,index)=><button type="button" data-gallery-select={index} data-full-src={optimized[index].src} data-image-alt={label(index)} data-caption={m.photo.replace('{index}',String(index+1)).replace('{total}',String(images.length))} aria-label={label(index)} aria-pressed={index===0?'true':'false'}><Image src={src} alt="" widths={[96,192]} sizes="96px" loading="lazy"/></button>)}</div>
</dialog>
