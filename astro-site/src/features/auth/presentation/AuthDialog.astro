---
import { authConfig, localeBrowserConfig } from '../data/build-config';
import { getAuthMessages } from '../data/messages';
import type { Locale } from '../../../shared/config/languages';
import './auth.css';
import AccountSummary from './AccountSummary.astro';
import EmailLocaleSettings from './EmailLocaleSettings.astro';
import {getLocaleMessages} from '../data/locale-messages';
interface Props { locale: Locale }
const { locale } = Astro.props;
const m = getAuthMessages(locale);
const intro = authConfig?.googleEnabled && authConfig.emailEnabled ? m.intro : authConfig?.googleEnabled ? m.googleIntro : m.emailIntro;
const localeSettings = localeBrowserConfig ? {config: localeBrowserConfig, messages: getLocaleMessages(locale)} : null;
const configuration = JSON.stringify({ config: authConfig, messages: m, locale, localeSettings }).replace(/</g, '\\u003c');
---
{authConfig && <>
  <script type="application/json" id="auth-config" set:html={configuration}/>
  <dialog class="auth-dialog" data-auth-dialog aria-labelledby="auth-title" aria-describedby="auth-intro">
    <div class="auth-content">
      <h2 id="auth-title">{m.title}</h2>
      <div data-auth-guest>
        <p id="auth-intro">{intro}</p>
        {authConfig.googleEnabled && <button type="button" class="auth-button auth-secondary auth-google" data-auth-google>
          <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
            <path fill="#4285F4" d="M43.61 24.46c0-1.36-.12-2.66-.35-3.91H24v7.4h11a9.4 9.4 0 0 1-4.08 6.18v5.14h6.61c3.87-3.56 6.08-8.81 6.08-14.81Z"/>
            <path fill="#34A853" d="M24 44c5.4 0 9.93-1.79 13.24-4.84l-6.61-5.14c-1.79 1.2-4.08 1.93-6.63 1.93-5.21 0-9.63-3.52-11.21-8.26H5.96v5.3A20 20 0 0 0 24 44Z"/>
            <path fill="#FBBC05" d="M12.79 27.69A12 12 0 0 1 12.16 24c0-1.28.22-2.52.63-3.69v-5.3H5.96A20 20 0 0 0 4 24c0 3.23.77 6.28 1.96 8.99Z"/>
            <path fill="#EA4335" d="M24 12.05c2.94 0 5.55 1.01 7.63 2.99l5.72-5.72A19.23 19.23 0 0 0 24 4 20 20 0 0 0 5.96 15.01l6.83 5.3c1.58-4.74 6-8.26 11.21-8.26Z"/>
          </svg>
          <span data-auth-google-label>{m.google}</span>
        </button>}
        {authConfig.emailEnabled && <form data-auth-form novalidate>
          <label for="auth-email">{m.email}</label>
          <input id="auth-email" name="email" type="email" inputmode="email" autocomplete="email" maxlength="254" required aria-describedby="auth-input-error auth-guidance"/>
          <p id="auth-input-error" class="auth-error" data-auth-input-error role="alert" hidden></p>
          <button type="submit" class="auth-button" data-auth-send>{m.send}</button>
          <p id="auth-guidance">{m.guidance}</p>
          <p data-auth-countdown role="timer" aria-live="off" hidden></p>
        </form>}
        <p class="auth-mode-switch"><span data-auth-mode-prompt>{m.noAccount}</span> <button type="button" data-auth-mode-switch>{m.signUp}</button></p>
      </div>
      <div data-auth-account hidden><p>{m.signedIn}</p><AccountSummary locale={locale}/>{localeSettings && <EmailLocaleSettings locale={locale}/>}<button type="button" class="auth-button auth-secondary" data-auth-signout>{m.signOut}</button></div>
      <p data-auth-status role="status" aria-live="polite" hidden></p>
      <a class="auth-privacy" href={`/${locale}/legal/`}>{m.privacy}</a>
      <button type="button" class="auth-close" data-auth-close>{m.notNow}</button>
    </div>
  </dialog>
</>}
<script>import './auth-interactions';</script>
