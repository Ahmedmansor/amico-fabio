---
import { authConfig } from '../data/build-config';
import { getAuthMessages } from '../data/messages';
import type { Locale } from '../../../shared/config/languages';
import './auth.css';
import AccountSummary from './AccountSummary.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const m = getAuthMessages(locale);
---
{authConfig && <section class="auth-entry"><p data-auth-entry-guest hidden>{m.loginIntro}</p><AccountSummary locale={locale}/><a href={`/${locale}/login/?redirect=${encodeURIComponent(`/${locale}/wishlist/`)}`} class="auth-button" data-auth-open hidden>{m.signIn}</a></section>}
