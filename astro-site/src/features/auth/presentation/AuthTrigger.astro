---
import { authConfig } from '../data/build-config';
import { getAuthMessages } from '../data/messages';
import type { Locale } from '../../../shared/config/languages';
import './auth.css';
interface Props { locale: Locale }
const { locale } = Astro.props;
const messages = getAuthMessages(locale);
---
{authConfig && <button type="button" class="auth-trigger" data-auth-open aria-label={messages.accountTitle} aria-haspopup="dialog" aria-busy="true" disabled data-signin-label={messages.signIn} data-greeting-tpl={messages.greeting} data-account-title={messages.accountTitle}>
  <span class="auth-trigger-avatar" data-avatar-loading="true">
    <img data-auth-avatar alt="" width="28" height="28" referrerpolicy="no-referrer" decoding="async" hidden/>
    <span data-auth-avatar-fallback aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="4"/><path d="M4 22v-2a8 8 0 0 1 16 0v2"/></svg></span>
  </span>
  <span class="auth-trigger-label">{messages.accountTitle}</span>
  <span class="auth-trigger-loading" aria-hidden="true"></span>
</button>}
