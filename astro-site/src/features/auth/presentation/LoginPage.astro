---
import {authConfig} from '../data/build-config';
import {getAuthMessages} from '../data/messages';
import type {Locale} from '../../../shared/config/languages';
import './auth.css';
import {marketingConsentEnabled} from '../../marketing/data/config';
import {getMarketingMessages} from '../../marketing/data/messages';
import MarketingConsent from '../../marketing/presentation/MarketingConsent.astro';
import EmailCodeInput from './EmailCodeInput.astro';
import PasswordInput from './PasswordInput.astro';
interface Props {locale:Locale}
const {locale}=Astro.props;
const m=getAuthMessages(locale);
const marketingEnabled=marketingConsentEnabled(import.meta.env),marketing=getMarketingMessages(locale);
const configuration=JSON.stringify({config:authConfig,messages:m,locale,marketingEnabled}).replace(/</g,'\\u003c');
---
<main class="auth-login auth-content" data-login-page>
  <h1 data-login-title>{m.title}</h1>
  <p data-login-intro>{m.loginIntro}</p>
  <script type="application/json" id="login-config" set:html={configuration}/>
  {authConfig ? <>
    <section data-login-guest>
      <div data-login-controls>
      {authConfig.googleEnabled && <button type="button" class="auth-button auth-secondary" data-login-oauth="google">{m.google}</button>}
      {authConfig.emailEnabled && <>
        {authConfig.passwordEnabled && <div class="auth-tabs" role="group" aria-label={m.loginMethod}>
          <button type="button" data-login-mode="signin" aria-pressed="true">{m.signIn}</button>
          <button type="button" data-login-mode="signup" aria-pressed="false">{m.signUp}</button>
        </div>}
        <form data-login-form novalidate>
          <div data-login-name-row hidden>
            <label for="login-first-name">{m.firstName}</label>
            <input id="login-first-name" name="first_name" type="text" autocomplete="given-name" maxlength="80" aria-describedby="login-first-name-error"/>
            <p id="login-first-name-error" class="auth-error" role="alert" hidden>{m.firstNameRequired}</p>
            <label for="login-last-name">{m.lastName}</label>
            <input id="login-last-name" name="last_name" type="text" autocomplete="family-name" maxlength="80" aria-describedby="login-last-name-error"/>
            <p id="login-last-name-error" class="auth-error" role="alert" hidden>{m.lastNameRequired}</p>
          </div>
          <label for="login-email">{m.email}</label>
          <input id="login-email" type="email" name="email" autocomplete="email" inputmode="email" maxlength="254" required aria-describedby="login-error login-suggestion"/>
          <div id="login-suggestion" class="auth-suggestion" data-login-suggestion hidden>
            <span></span><button type="button" class="auth-suggestion-button" data-login-correct>{m.useSuggestion}</button>
          </div>
          {authConfig.passwordEnabled && <div data-login-password-row>
            <label for="login-password">{m.password}</label>
            <PasswordInput id="login-password" name="password" autocomplete="current-password" required describedBy="password-guidance" showLabel={m.showPassword} hideLabel={m.hidePassword}/>
            <p id="password-guidance" data-login-password-hint hidden>{m.passwordGuidance}</p>
            <div data-login-confirm-row hidden>
              <label for="login-password-confirm">{m.confirmPassword}</label>
              <PasswordInput id="login-password-confirm" name="password_confirmation" describedBy="login-password-match-error" showLabel={m.showPassword} hideLabel={m.hidePassword}/>
              <p id="login-password-match-error" class="auth-error" role="alert" hidden>{m.passwordMismatch}</p>
            </div>
          </div>}
          {marketingEnabled && authConfig.passwordEnabled && <label class="auth-reminder-optin" data-login-marketing-row hidden><input type="checkbox" data-login-marketing-intent/>{marketing.label}</label>}
          {authConfig.turnstileSiteKey && <div data-login-captcha></div>}
          <p id="login-error" class="auth-error" role="alert" data-login-error hidden></p>
          <button type="submit" class="auth-button" data-login-submit disabled>{authConfig.passwordEnabled?m.signIn:m.send}</button>
          {authConfig.passwordEnabled && <button type="button" class="auth-close" data-login-recovery>{m.forgotPassword}</button>}
        </form>
      </>}
      <p class="auth-legal-acknowledgement">{m.legalBefore} <a href={`/${locale}/legal/#liability`}>{m.terms}</a> {m.legalAnd} <a href={`/${locale}/legal/#intro`}>{m.privacy}</a>.</p>
      </div>
      <section data-login-check-email hidden aria-labelledby="check-email-title">
        <h2 id="check-email-title" class="sr-only">{m.checkInbox}</h2>
        <p data-login-delivery-message></p>
        <p data-login-sent-to></p>
        <form data-login-code-form novalidate>
          <EmailCodeInput label={m.emailCode}/>
          <p id="login-code-error" class="auth-error" data-login-code-error role="alert" hidden></p>
          <button type="submit" class="auth-button" data-login-verify-code disabled>{m.verifyCode}</button>
        </form>
        <p>{m.otherBrowserGuidance}</p>
        <details data-login-resend-options>
          <summary>{m.requestNewCode}</summary>
          {authConfig.turnstileSiteKey && <div data-login-resend-captcha></div>}
          <button type="button" class="auth-button auth-secondary" data-login-resend-code disabled>{m.resendCode}</button>
        </details>
        <button type="button" class="auth-button auth-secondary" data-login-back-to-signin>{m.backToSignIn}</button>
      </section>
    </section>
    <section data-login-account hidden>
      <a class="auth-button" href={`/${locale}/wishlist/`} data-login-return>{m.viewFavorites}</a>
      {authConfig.passwordEnabled && <details class="auth-password-settings" data-login-password-settings>
        <summary>{m.optionalPassword}</summary>
        <form data-login-set-password novalidate>
        <label for="account-password">{m.setPassword}</label>
        <PasswordInput id="account-password" minlength={12} required describedBy="account-password-guidance" showLabel={m.showPassword} hideLabel={m.hidePassword}/>
        <p id="account-password-guidance">{m.passwordGuidance}</p>
        <label for="account-password-confirm">{m.confirmPassword}</label>
        <PasswordInput id="account-password-confirm" required describedBy="account-password-match-error" showLabel={m.showPassword} hideLabel={m.hidePassword}/>
        <p id="account-password-match-error" class="auth-error" role="alert" hidden>{m.passwordMismatch}</p>
        <button type="submit" class="auth-button auth-secondary" disabled>{m.savePassword}</button>
        </form>
      </details>}
      <MarketingConsent locale={locale}/>
    </section>
  </> : <p>{m.unavailable}</p>}
  <p data-login-status role="status" aria-live="polite"></p>
  <p data-login-cooldown role="timer" aria-live="off" hidden></p>
  <noscript><p>{m.javascript}</p></noscript>
</main>
<script>import './login-interactions';</script>
