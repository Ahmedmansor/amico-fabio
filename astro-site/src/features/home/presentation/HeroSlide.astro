---
import {Picture} from 'astro:assets';
import type {ImageMetadata} from 'astro';
interface Props {image:ImageMetadata;title:string;active?:boolean;fallback?:boolean}
const {image,title,active=false,fallback=false}=Astro.props;
---
<Picture src={image} alt={title} width={600} height={400} fit="cover"
  formats={['avif','webp']} quality={65} class:list={['hero-slide',{'active-slide':active}]}
  widths={[400,600]} sizes="(min-width: 1200px) 700px, (min-width: 768px) 55vw, 100vw"
  loading={fallback?'lazy':'eager'} fetchpriority={active?'high':'low'}/>
