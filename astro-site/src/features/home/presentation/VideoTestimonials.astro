---
import {Image} from 'astro:assets';
import type {HomeJourney} from '../domain/home';
import type {OfferTestimonial} from '../../sharm-offer/domain/testimonials';
import {offerImage} from '../../sharm-offer/presentation/images';
interface Props {title:string;videos:OfferTestimonial[];copy:HomeJourney}
const {title,videos,copy}=Astro.props;
---
<section class="home-videos" aria-labelledby="home-videos-title">
  <div class="home-width">
    <header class="home-video-heading"><div class="home-section-heading"><p class="home-eyebrow">Fabio Egypt</p><h2 id="home-videos-title">{title}</h2><p>{copy.videoIntro}</p></div><span class="home-video-language"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 5h18v12H8l-5 4V5ZM7 9h10M7 13h6"/></svg>{copy.videoLanguage}</span></header>
    <div class="home-video-grid">{videos.map((video,index)=><a class="home-video-card" data-desktop-reveal data-home-video={video.videoId} href={`https://vimeo.com/${video.videoId}`} target="_blank" rel="noopener noreferrer" aria-haspopup="dialog">
      <div class="home-video-media"><Image src={offerImage(video.image)} alt="" widths={[320,480,800]} sizes="(min-width:1024px) 390px, (min-width:768px) 45vw, 85vw" loading="lazy" format="webp" quality={65}/><span class="home-video-number">{String(index+1).padStart(2,'0')}</span><span class="home-video-play" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="m9 5 11 7-11 7V5Z"/></svg></span></div>
      <div class="home-video-caption"><h3>{video.title}</h3><span>{copy.playVideo}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></span></div>
    </a>)}</div>
    <div class="home-video-privacy"><p>{copy.videoConsent}</p><button type="button" data-home-video-preferences>{copy.manageVideoConsent}</button></div>
  </div>
</section>
<dialog class="home-video-dialog" aria-labelledby="home-video-title">
  <div class="home-video-toolbar"><h2 id="home-video-title"></h2><button type="button" data-close-home-video aria-label={copy.closeVideo}><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg></button></div>
  <div class="home-video-player" data-home-video-player></div>
  <a class="home-video-fallback" data-home-video-fallback href={`https://vimeo.com/${videos[0].videoId}`} target="_blank" rel="noopener noreferrer">{copy.openOnVimeo}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a>
</dialog>
<script>import './video-testimonials';</script>
