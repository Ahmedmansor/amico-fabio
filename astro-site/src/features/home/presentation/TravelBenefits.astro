---
interface Props {title:string;items:{title:string;text:string}[]}
const {title,items}=Astro.props;
const paths=['M12 21s7-6 7-12a7 7 0 1 0-14 0c0 6 7 12 7 12Z','M4 5h16v12H8l-4 4V5Z','M14 2H6a2 2 0 0 0-2 2v16h16V8l-6-6Zm0 0v6h6M8 12h8M8 16h6'];
---
<section class="home-evidence home-width" aria-labelledby="home-benefits-title">
  <div class="home-section-heading"><p class="home-eyebrow">Fabio Egypt</p><h2 id="home-benefits-title">{title}</h2></div>
  <div class="home-benefits">{items.map((item,index)=><article class="home-benefit" data-desktop-reveal>
    <span class="home-benefit-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={paths[index]}/>{index===0&&<circle cx="12" cy="9" r="2.5"/>}{index===1&&<path d="M8 9h8M8 13h5"/>}</svg></span>
    <h3>{item.title}</h3><p>{item.text}</p>
  </article>)}</div>
</section>
