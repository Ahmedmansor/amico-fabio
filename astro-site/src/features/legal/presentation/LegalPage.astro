---
import './legal.css';
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import { getSharedMessages } from '@shared/i18n/shared';
import type { Locale } from '@shared/config/languages';
import { groupParagraphs, getDataChips, type LegalPage } from '../domain/legal';
interface Props { locale: Locale; page: LegalPage; icons: Record<string, string> }
const { locale, page, icons } = Astro.props;
const shared = getSharedMessages(locale);
---
<BaseLayout locale={locale} route="legal" title={`Fabio Egypt | ${page.title}`} description={page.sections[0].paragraphs[0]}>
  <main class="legal-page">
   <div class="legal-container">
    <header class="legal-heading"><a href={`/${locale}/`}>{shared.menu.home}<span aria-hidden="true"> / </span></a><h1 class="legal-title">{page.title}</h1></header>
    <details class="legal-mobile-toc"><summary>{page.toc_title}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary><nav data-legal-toc aria-label={page.toc_title}>{page.summary_items.map(item => <a class="legal-link" href={`#${item.id}`}>{item.label}</a>)}</nav></details>
    <div class="legal-grid">
      <aside class="legal-sidebar"><div class="legal-card"><h2 class="legal-toc-title">{page.toc_title}</h2><nav id="legal-toc" data-legal-toc aria-label={page.toc_title}>{page.toc.map(item => <a class="legal-link" href={`#${item.id}`}>{item.label}</a>)}</nav></div></aside>
      <article id="legal-content" aria-label={page.title}>{page.sections.map(section =>
        <section class="legal-section" id={section.id} aria-labelledby={`legal-heading-${section.id}`}>
          <div class="legal-section-heading"><img src={icons[section.id]} alt="" width="24" height="24"/><h2 class="legal-subtitle" id={`legal-heading-${section.id}`}>{section.heading}</h2></div>
          {section.id === 'data_types' && <div class="legal-chip-list">{getDataChips(section.paragraphs).map(chip => <span class="legal-data-chip">{chip}</span>)}</div>}
          {groupParagraphs(section.paragraphs).map(block => block.type === 'list'
            ? <ul class="legal-list">{block.items.map(text => <li>{text}</li>)}</ul>
            : <p>{block.text}</p>)}
        </section>
      )}</article>
    </div>
   </div>
  </main>
</BaseLayout>
<script>
  import './legal-interactions';
</script>
