---
import type { Locale } from '../../../shared/config/languages';
import type { Offer } from '../../../shared/domain/offers';
import WishlistCard from './WishlistCard.astro';
import { getWishlistMessages } from '../data/messages';
import Heart from './Heart.astro';
import AuthEntry from '../../auth/presentation/AuthEntry.astro';
import WishlistSyncStatus from './WishlistSyncStatus.astro';
import './wishlist.css';
import { favoriteKey } from '../domain/wishlist';
interface Props { locale: Locale; trips: Offer[]; packages: Offer[] }
const { locale, trips, packages } = Astro.props;
const m = getWishlistMessages(locale);
---
<main class="wishlist-page" data-wishlist-page data-unavailable={m.unavailable}>
  <section class="wishlist-heading">
    <h1>{m.title}</h1>
    <p data-wishlist-storage-message>{m.local}</p>
    <a href={`/${locale}/explore/`} class="wishlist-browse">{m.browse}<span aria-hidden="true"> →</span></a>
  </section>
  <AuthEntry locale={locale}/>
  <slot name="email-test"/>
  <slot name="reminder-preferences"/>
  <aside class="wishlist-inline-reminder" data-wishlist-inline-reminder hidden>
    <p>{m.inlineReminderPrompt}</p>
    <button type="button" class="wishlist-inline-reminder-btn" data-wishlist-inline-reminder-enable>
      {m.inlineReminderEnable}
    </button>
  </aside>
  <p data-wishlist-catalog-notice class="wishlist-notice" hidden>{m.catalogUnavailable}</p>
  <WishlistSyncStatus locale={locale}/>
  <p data-wishlist-error class="wishlist-notice" role="alert" hidden></p>
  <section data-wishlist-empty class="wishlist-empty" hidden>
    <Heart/><p>{m.empty}</p>
  </section>
  <section class="wishlist-section" data-wishlist-section hidden aria-labelledby="wishlist-tours-title">
    <h2 id="wishlist-tours-title">{m.tours}</h2>
    <div class="wishlist-grid">
      {trips.map(trip => <div data-wishlist-item data-trip-id={favoriteKey('trip', trip.id)} hidden><WishlistCard trip={trip} locale={locale}/></div>)}
    </div>
  </section>
  <section class="wishlist-section" data-wishlist-section hidden aria-labelledby="wishlist-packages-title">
    <h2 id="wishlist-packages-title">{m.packages}</h2>
    <div class="wishlist-grid">
      {packages.map(trip => <div data-wishlist-item data-trip-id={favoriteKey('package', trip.id)} hidden><WishlistCard trip={trip} kind="package" locale={locale}/></div>)}
    </div>
  </section>
  <noscript><p class="wishlist-notice">{m.javascript}</p></noscript>
</main>
<script>import './wishlist-interactions';</script>
