---
import type { Locale } from '../../../shared/config/languages';
import type { Offer } from '../../../shared/domain/offers';
import WishlistCard from './WishlistCard.astro';
import { getWishlistMessages } from '../data/messages';
import Heart from './Heart.astro';
import './wishlist.css';
interface Props { locale: Locale; trips: Offer[] }
const { locale, trips } = Astro.props;
const m = getWishlistMessages(locale);
---
<main class="wishlist-page" data-wishlist-page data-unavailable={m.unavailable}>
  <section class="wishlist-heading">
    <h1>{m.title}</h1>
    <p>{m.local}</p>
    <a href={`/${locale}/explore/`} class="wishlist-browse">{m.browse}<span aria-hidden="true"> →</span></a>
  </section>
  <p data-wishlist-error class="wishlist-notice" role="alert" hidden></p>
  <section data-wishlist-empty class="wishlist-empty" hidden>
    <Heart/><p>{m.empty}</p>
  </section>
  <div class="wishlist-grid">
    {trips.map(trip => <div data-wishlist-item data-trip-id={trip.id} hidden><WishlistCard trip={trip} locale={locale}/></div>)}
  </div>
  <noscript><p class="wishlist-notice">{m.javascript}</p></noscript>
</main>
<script>import './wishlist-interactions';</script>
