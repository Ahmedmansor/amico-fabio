---
import type {Locale} from '../../../shared/config/languages';
import {accountSyncEnabled} from '../data/build-config';
import {getWishlistMessages} from '../data/messages';
import {getAuthMessages} from '../../auth/data/messages';
interface Props {locale:Locale}
const m=getWishlistMessages(Astro.props.locale),auth=getAuthMessages(Astro.props.locale);
---
{accountSyncEnabled && <aside class="wishlist-invitation" data-wishlist-invitation aria-labelledby="wishlist-invitation-title" hidden>
  <h2 id="wishlist-invitation-title">{m.invitationTitle}</h2>
  <p role="status">{m.invitationBody}</p>
  <div class="wishlist-invitation-actions">
    <button type="button" class="wishlist-sync-button" data-auth-open data-wishlist-invite-signin aria-haspopup="dialog" hidden>{auth.signIn}</button>
    <button type="button" class="wishlist-invitation-dismiss" data-wishlist-invite-dismiss>{auth.notNow}</button>
  </div>
</aside>}
