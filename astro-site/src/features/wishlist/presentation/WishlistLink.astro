---
import type { Locale } from '../../../shared/config/languages';
import { getWishlistMessages } from '../data/messages';
import Heart from './Heart.astro';
import WishlistBootstrap from './WishlistBootstrap.astro';
import './wishlist.css';
interface Props { locale: Locale; active: boolean }
const { locale, active } = Astro.props;
const messages = getWishlistMessages(locale);
---
<a class="wishlist-link" href={`/${locale}/wishlist/`} data-wishlist-link data-base-label={messages.title} data-count-label={messages.countLabel} aria-label={messages.title} aria-current={active ? 'page' : undefined}><Heart/><span class="wishlist-count" data-wishlist-count aria-hidden="true" hidden></span><span class="wishlist-loading" aria-hidden="true"></span></a>
<script>import './wishlist-interactions';</script>
<WishlistBootstrap locale={locale}/>
