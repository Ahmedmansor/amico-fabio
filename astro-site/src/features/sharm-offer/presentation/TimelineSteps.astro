---
import type {OfferCampaign} from '../domain/campaign';
interface Props {campaign:OfferCampaign}
const {campaign}=Astro.props;
const copy=campaign.copy;
---
<div id="timeline-section">
      <section class="osh-section osh-section--alt" id="timeline-block">
        <div class="osh-container">
          <div class="osh-section-header">
            <h2 class="osh-section-title">{copy["TimelineSteps.text.0"]}</h2>
          </div>
          <div class="osh-timeline">

              <div class="osh-timeline-step">
                <div class="osh-timeline-icon-wrap">
                  <span class="osh-timeline-number">{copy["TimelineSteps.text.1"]}</span>
                  <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                  <div class="osh-timeline-line"></div>
                </div>
                <h3 class="osh-timeline-title">{copy["TimelineSteps.text.2"]}</h3>
                <p class="osh-timeline-desc">{copy["TimelineSteps.text.3"]}</p>
              </div>

              <div class="osh-timeline-step">
                <div class="osh-timeline-icon-wrap">
                  <span class="osh-timeline-number">{copy["TimelineSteps.text.4"]}</span>
                  <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  <div class="osh-timeline-line"></div>
                </div>
                <h3 class="osh-timeline-title">{copy["TimelineSteps.text.5"]}</h3>
                <p class="osh-timeline-desc">{copy["TimelineSteps.text.6"]}</p>
              </div>

              <div class="osh-timeline-step">
                <div class="osh-timeline-icon-wrap">
                  <span class="osh-timeline-number">{copy["TimelineSteps.text.7"]}</span>
                  <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                  <div class="osh-timeline-line"></div>
                </div>
                <h3 class="osh-timeline-title">{copy["TimelineSteps.text.8"]}</h3>
                <p class="osh-timeline-desc">{copy["TimelineSteps.text.9"]}</p>
              </div>

              <div class="osh-timeline-step">
                <div class="osh-timeline-icon-wrap">
                  <span class="osh-timeline-number">{copy["TimelineSteps.text.10"]}</span>
                  <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  <div class="osh-timeline-line"></div>
                </div>
                <h3 class="osh-timeline-title">{copy["TimelineSteps.text.11"]}</h3>
                <p class="osh-timeline-desc">{copy["TimelineSteps.text.12"]}</p>
              </div>

          </div>
        </div>
      </section>

</div>
