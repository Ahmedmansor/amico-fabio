---
import '../../../shared/styles/global.css';
import '../../../shared/styles/legacy-shell.css';
import {languages,supportedLocales,type Locale} from '../../../shared/config/languages';
import PageHead from '../../../shared/seo/PageHead.astro';
import {getManagementMessages} from '../data/management-messages';
import {readManagementBrowserConfig} from '../data/management-config';
interface Props {locale:Locale}
const {locale}=Astro.props,m=getManagementMessages(locale),config=readManagementBrowserConfig(import.meta.env);
const settings=JSON.stringify({config,m,locale}).replace(/</g,'\\u003c');
---
<!doctype html>
<html lang={locale} dir={languages[locale].direction}>
  <head>
    <meta name="referrer" content="no-referrer"/>
    <PageHead locale={locale} route="email-preferences" title={`${m.title} | Fabio Egypt`} description={m.intro} noindexOverride={true}/>
  </head>
  <body>
    <main data-email-management>
      <p class="brand">FABIO EGYPT</p><h1>{m.title}</h1><p>{m.intro}</p>
      <form data-management-form hidden>
        <label for="management-language">{m.language}</label>
        <select id="management-language" data-management-language aria-describedby="management-status">
          {supportedLocales.map(code=><option value={code}>{languages[code].label}</option>)}
        </select>
        <button type="submit" data-management-save>{m.save}</button>
        <button type="button" data-management-stop>{m.unsubscribe}</button>
      </form>
      <p id="management-status" role="status" aria-live="polite" data-management-status>{config?m.loading:m.disabled}</p>
      <noscript><p>{m.noScript}</p></noscript>
      <button type="button" data-management-retry hidden>{m.retry}</button>
      <a href={`/${locale}/wishlist/`}>{m.back}</a>
    </main>
    <script type="application/json" id="email-management-config" set:html={settings}/>
    <script>import './management-interactions';</script>
  </body>
</html>
<style>
  body{margin:0;background:#000;color:var(--color-text-light);font-family:Montserrat,sans-serif;}
  main{max-width:38rem;margin:clamp(24px,8vh,80px) auto;padding:24px;border:1px solid var(--color-gold);border-radius:16px;}
  h1,.brand{color:var(--color-gold-soft);}h1{font-family:'Playfair Display',serif;font-size:clamp(1.75rem,5vw,2.25rem);line-height:1.3;margin:16px 0;}p{line-height:1.7;}
  form[hidden],[hidden]{display:none!important;}label,select,a{display:block;}select{width:100%;min-height:48px;margin:12px 0;padding:10px;font:inherit;font-size:16px;background:black;color:inherit;border:1px solid var(--color-gold);border-radius:8px;}
  button{min-height:48px;padding:10px 18px;margin:8px 8px 8px 0;background:transparent;color:var(--color-gold-soft);border:1px solid var(--color-gold);border-radius:24px;font:inherit;cursor:pointer;}
  button:disabled{opacity:.55;cursor:default;}a{width:fit-content;min-height:44px;padding:12px 0;color:var(--color-gold-soft);}
  :is(button,select,a):focus-visible{outline:3px solid var(--color-gold-soft);outline-offset:4px;}
  @media(max-width:640px){main{margin:20px 12px;padding:20px;}}
</style>
