---
import {Image} from 'astro:assets';
import type {ImageMetadata} from 'astro';
import type {getArticleViews} from '../../data/views';
import {articleUrl} from '../../domain/translations';
import {listingUrl} from '../../domain/listings';
import {readingTimeMinutes} from '../../domain/reading-time';
import {getSharedMessages} from '../../../../shared/i18n/shared';
import {siteConfig} from '../../../../shared/config/site';
import {getShareImage} from '../../../../shared/seo/share-image';
import BlogLayout from '../../../../shared/layouts/EditorialLayout.astro';
import CtaCard from '../components/CtaCard.astro';
import PostCard from '../components/PostCard.astro';
import InquiryForm from '../components/InquiryForm.astro';
import RelatedTour from '../components/RelatedTour.astro';
import {articleStructuredData,serializeStructuredData} from '../seo';
import TableOfContents from '../../../../shared/components/editorial/TableOfContents.astro';
import ArticleFaq from '../../../../shared/components/editorial/ArticleFaq.astro';
interface Props {view:Awaited<ReturnType<typeof getArticleViews>>[number];images:Record<string,ImageMetadata>}
const {view,images}=Astro.props,{post,author,alternates,navigation,related}=view;
const m=getSharedMessages(post.lang).blog;
const shareImage=await getShareImage(images[post.id],post.hero.alt);
const structuredData=articleStructuredData(post,view.authorIdentity,{site:siteConfig.url,assetOrigin:import.meta.env.PUBLIC_ASSET_ORIGIN,image:shareImage,home:m.home,journal:m.journal,destination:post.destination?m.destinationLabels[post.destination]:undefined});
const date=(value:string)=>new Intl.DateTimeFormat(post.lang,{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(value));
---
<BlogLayout locale={post.lang} title={post.title} description={post.description} path={articleUrl(post)} alternates={alternates} navigation={navigation} fixture={post.fixture} article articleId={post.id} destination={post.destination} shareImage={shareImage}>
  <Fragment slot="head">
    <meta property="article:published_time" content={new Date(post.pubDate).toISOString()}/>
    {post.updatedDate&&<meta property="article:modified_time" content={new Date(post.updatedDate).toISOString()}/>}
    <script is:inline type="application/ld+json" set:html={serializeStructuredData(structuredData)}/>
  </Fragment>
  <main id="blog-main" class="blog-article-page">
    <div class="blog-container"><nav class="blog-breadcrumbs" aria-label={m.navigation}><a href={`/${post.lang}/`}>{m.home}</a><span aria-hidden="true">/</span><a href={listingUrl(post.lang)}>{m.journal}</a>{post.destination&&<><span aria-hidden="true">/</span><a href={listingUrl(post.lang,'destinations',post.destination)}>{m.destinationLabels[post.destination]}</a></>}<span aria-hidden="true">/</span><span>{post.title}</span></nav></div>
    <header class="blog-container blog-article-heading"><div class="blog-chips">{post.destination&&<a href={listingUrl(post.lang,'destinations',post.destination)}>{m.destinationLabels[post.destination]}</a>}{post.interests.map(interest=><a href={listingUrl(post.lang,'interests',interest)}>{m.interestLabels[interest]}</a>)}</div><h1>{post.title}</h1><p class="blog-article-description">{post.description}</p><div class="blog-meta"><span>{m.by} {author}</span><span aria-hidden="true">·</span><time datetime={post.pubDate}>{date(post.pubDate)}</time><span aria-hidden="true">·</span><span>{m.readingTime.replace('{n}',String(readingTimeMinutes(post.body)))}</span>{post.updatedDate&&<span>{m.updated}: <time datetime={post.updatedDate}>{date(post.updatedDate)}</time></span>}</div></header>
    <figure class="blog-container blog-article-hero"><Image src={images[post.id]} alt={post.hero.alt} widths={[640,960,1280,1536]} sizes="(min-width:1280px) 1240px, 100vw" format="webp" loading="eager" fetchpriority="high"/>{post.hero.caption&&<figcaption>{post.hero.caption}</figcaption>}</figure>
    <div class="blog-container blog-article-grid"><div class="blog-reading"><TableOfContents locale={post.lang} headings={view.outline}/><article class="blog-prose" id="editorial-introduction"><slot/></article><ArticleFaq locale={post.lang} items={post.faq??[]}/></div><aside class="blog-aside" id="blog-inquiry"><div class="blog-inquiry-card"><p class="blog-kicker">Fabio Egypt</p><h2>{m.formTitle}</h2><p>{m.formHint}</p><InquiryForm locale={post.lang} prefix="desktop" destination={post.destination}/></div></aside></div>
    {view.relatedTrip&&<RelatedTour trip={view.relatedTrip} locale={post.lang}/>}
    {!view.hasInlineCta&&<div class="blog-container blog-section"><CtaCard locale={post.lang}/></div>}
    {related.length>0&&<section class="blog-container blog-section"><div class="blog-section-heading"><h2>{m.related}</h2><a class="blog-text-link" href={listingUrl(post.lang)}>{m.allStories}<span aria-hidden="true">↗</span></a></div><div class="blog-post-grid">{related.map(item=><PostCard post={item} image={images[item.id]}/>)}</div></section>}
  </main>
  <div class="blog-mobile-bar"><a class="blog-button" href={`https://wa.me/${siteConfig.whatsapp.number}`} data-open-lead aria-controls="blog-inquiry-dialog" aria-haspopup="dialog">{m.mobileButton}<span aria-hidden="true">↗</span></a></div>
</BlogLayout>
