---
import {Image} from 'astro:assets';
import {imageAssets} from '../../../tours/presentation/images';
import {getSharedMessages} from '../../../../shared/i18n/shared';
import type {Locale} from '../../../../shared/config/languages';
import type {RelatedTrip} from '../../domain/related-trip';
interface Props {trip:RelatedTrip;locale:Locale}
const {trip,locale}=Astro.props;
const image=imageAssets[trip.poster];
if(!image)throw new Error(`[blog:${trip.id}] Related trip poster is unavailable: ${trip.poster}`);
---
<section class="blog-container blog-section" data-related-tour>
  <h2 class="blog-related-tour-heading">{getSharedMessages(locale).blog.relatedTour}</h2>
  <a class="blog-related-tour" href={trip.url}>
    <Image src={image} alt="" widths={[400,640]} sizes="(min-width:768px) 360px, 100vw" loading="lazy" format="webp"/>
    <div><p class="blog-kicker">Fabio Egypt</p><h3>{trip.title}</h3><span class="blog-text-link">{getSharedMessages(locale).blog.relatedTour} <span aria-hidden="true">↗</span></span></div>
  </a>
</section>
