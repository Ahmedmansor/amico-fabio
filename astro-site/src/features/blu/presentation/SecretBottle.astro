---
import type {BluCopy} from '../data/campaign';
import {passphrase} from '../domain/campaign';
import bottle from './assets/bottle.svg?raw';
interface Props {copy:BluCopy;whatsapp:string}
const {copy,whatsapp}=Astro.props;
---
<section id="secret-bottle-section" class="blu-secret blu-box" aria-labelledby="blu-bottle-title">
 <div class="blu-secret-copy"><span class="blu-eyebrow">{copy.promoBadge}</span><h2 id="blu-bottle-title">{copy.promoTitle}</h2><p>{copy.promoDesc}</p>
  <ul class="blu-perks">{[1,2,3].map(n=><li><strong>{copy[`perk${n}Title` as keyof BluCopy]}</strong><span>{copy[`perk${n}Desc` as keyof BluCopy]}</span></li>)}</ul>
 </div>
 <div class="blu-bottle-card">
  <a href={whatsapp} target="_blank" rel="noopener noreferrer" data-blu-whatsapp class="blu-bottle-link" aria-label={copy.claimWhatsappBtn}><span aria-hidden="true" set:html={bottle}/></a>
  <p class="blu-code-label">{copy.codeLabel}</p><code id="blu-passphrase">{passphrase}</code>
  <button class="blu-copy" type="button" data-copy hidden>{copy.copyBtn}</button><p class="blu-copy-status" data-copy-status role="status" aria-live="polite"></p>
  <p class="blu-selected" data-selection-status role="status" aria-live="polite"></p>
  <a class="blu-button blu-button-green" href={whatsapp} target="_blank" rel="noopener noreferrer" data-blu-whatsapp>{copy.claimWhatsappBtn}<span aria-hidden="true">↗</span></a>
  <p class="blu-wa-note">{copy.waGuarantee}</p>
 </div>
</section>
