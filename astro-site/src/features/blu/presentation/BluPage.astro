---
import DocumentShell from '../../../shared/layouts/DocumentShell.astro';
import PageHead from '../../../shared/seo/PageHead.astro';
import {siteConfig} from '../../../shared/config/site';
import {buildBluWhatsApp} from '../domain/campaign';
import type {BluCampaign} from '../data/campaign';
import type {BluRelatedTrip} from '../data/related-trips';
import LandingHeader from './LandingHeader.astro';
import LandingFooter from './LandingFooter.astro';
import Portal from './Portal.astro';
import ExperienceCards from './ExperienceCards.astro';
import SecretBottle from './SecretBottle.astro';
import RelatedTrips from './RelatedTrips.astro';
import UnderwaterDecor from './UnderwaterDecor.astro';
import './blu.css';
interface Props {campaign:BluCampaign;trips:BluRelatedTrip[]}
const {campaign,trips}=Astro.props;
const {copy,locale}=campaign;
const whatsapp=buildBluWhatsApp(siteConfig.whatsapp.number,copy.waDefaultMsg);
const browserConfig={locale,number:siteConfig.whatsapp.number,copy,experiences:campaign.experiences};
---
<DocumentShell locale={locale} campaign="blu" bodyClass="blu-page">
 <PageHead slot="head" locale={locale} route="blu" title={copy.title} description={copy.description} canonicalPath={campaign.path} alternatePaths={campaign.alternates} fontPreloads={[]}/>
 <UnderwaterDecor/><LandingHeader campaign={campaign}/>
 <main id="blu-main" class="blu-width" tabindex="-1">
  <section class="blu-hero" aria-labelledby="blu-title">
   <div class="blu-hero-copy"><p class="blu-mystery-badge"><span aria-hidden="true"></span>{copy.heroBadge}</p>
    <h1 id="blu-title">{copy.heroTitle}</h1><p class="blu-hero-description">{copy.heroSub}</p>
    <blockquote class="blu-quote blu-box"><span>{copy.fabioSaysLabel}</span><p>«{copy.fabioQuote}»</p><cite>— Fabio</cite></blockquote>
    <div class="blu-hero-actions"><a class="blu-button blu-button-yellow" href="#character-lore-section">{copy.btnExplore}<span aria-hidden="true">↓</span></a><a class="blu-button blu-button-green" href={whatsapp} target="_blank" rel="noopener noreferrer" data-blu-whatsapp>{copy.btnWhatsapp}<span aria-hidden="true">↗</span></a></div>
   </div>
   <Portal copy={copy}/>
  </section>
  <div class="blu-story-layout"><div><ExperienceCards campaign={campaign}/><SecretBottle copy={copy} whatsapp={whatsapp}/></div><RelatedTrips copy={copy} trips={trips}/></div>
 </main>
 <LandingFooter campaign={campaign} whatsapp={whatsapp}/>
 <script id="blu-config" type="application/json" set:html={JSON.stringify(browserConfig).replaceAll('<','\u003c')}/>
 <script>import './interactions';</script>
</DocumentShell>
