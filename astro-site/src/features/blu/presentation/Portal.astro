---
import {Image} from 'astro:assets';
import type {BluCopy} from '../data/campaign';
import sheet from './assets/fabio-sheet.webp';
import village from './assets/village.svg?raw';
import sea from '../../../shared/assets/catalog/trips/sharm/sea/ras_mohammed_bus_half_day/3.webp';
interface Props {copy:BluCopy}
const {copy}=Astro.props;
