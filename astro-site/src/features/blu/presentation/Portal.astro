<figure class="blu-portal-panel blu-box">
 <figcaption class="blu-portal-title">{copy.portalTitle}</figcaption>
 <div class="blu-poses" data-pose-controls hidden>
  {[copy.pose1,copy.pose2,copy.pose3].map((pose,index)=><button type="button" data-pose={index+1} aria-pressed={index===0}>{pose}</button>)}
 </div>
 <div class="blu-portal" data-portal>
  <div class="blu-real-world">
   <Image src={sea} alt={copy.realImageAlt} widths={[480,800,1100]} sizes="(min-width:1200px) 420px, (min-width:768px) 45vw, 100vw" loading="eager" fetchpriority="high" format="webp"/>
   <span class="blu-portal-label">{copy.realLabel}</span>
   <div class="blu-real-caption"><strong>{copy.realSideTitle}</strong><p>{copy.realSideDesc}</p></div>
  </div>
  <div class="blu-cartoon-world" data-cartoon-overlay>
   <div class="blu-village" aria-hidden="true" set:html={village}/>
