---
import {Image,getImage} from 'astro:assets';
import type {TourPage} from '../../tours/domain/details';
import type {Locale} from '../../../shared/config/languages';
import {imageAssets} from './images';
interface Props {included:TourPage[];locale:Locale}
const {included}=Astro.props;
const cards=await Promise.all(included.map(async item=>({item,slides:await Promise.all(item.gallery.map(async src=>(await getImage({src:imageAssets[src],width:192,format:'webp'})).src))})));
---
{cards.map(({item,slides})=><button type="button" data-trip-id={item.trip.id} data-slides={JSON.stringify(slides)} class="text-left bg-gray-900 border border-gray-800 rounded-xl p-3 hover:border-gold hover:shadow-lg transition flex gap-4 group overflow-hidden"><div class="w-24 h-24 shrink-0 rounded-lg overflow-hidden relative"><Image id={`trip-img-${item.trip.id}`} src={imageAssets[item.gallery[0]]} widths={[96,192]} sizes="96px" class="w-full h-full object-cover transform group-hover:scale-110 transition duration-700" loading="lazy" alt={item.text.title}/></div><div class="flex flex-col gap-1 flex-1 min-w-0 justify-center"><h4 class="text-white font-semibold text-sm md:text-base truncate pr-2 group-hover:text-gold transition-colors">{item.text.title}</h4><p class="text-gold text-xs font-bold uppercase tracking-wider">{item.text.duration}</p><p class="text-gray-400 text-xs line-clamp-2 leading-relaxed">{item.text.short_desc}</p></div></button>)}
