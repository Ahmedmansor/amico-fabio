---
import {Image} from 'astro:assets';
import type {TourPage} from '../../tours/domain/details';
import type {Locale} from '../../../shared/config/languages';
import {getSharedMessages} from '../../../shared/i18n/shared';
import {imageAssets} from './images';
import {listHtml,modalProgramHtml} from './markup';
import PackageGallery from './PackageGallery.astro';
interface Props {included:TourPage[];locale:Locale}
const {included,locale}=Astro.props,m=getSharedMessages(locale);
const copy=(key:string)=>key.split('.').reduce((value:any,part)=>value[part],m);
---
<div id="included-trip-modal"
        class="fixed inset-0 z-[90] hidden bg-black/95 backdrop-blur-sm flex items-center justify-center p-4">
        <div
            class="bg-gray-900 border border-gold rounded-2xl w-full max-w-5xl lg:max-w-4xl h-auto max-h-[90vh] overflow-y-auto relative shadow-[0_0_40px_rgba(212,175,55,0.3)] flex flex-col">
            <button id="included-trip-modal-close" type="button"
                class="fixed top-4 right-4 z-[100] bg-black/50 text-white rounded-full p-2 hover:bg-gold hover:text-black transition backdrop-blur-md">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12">
                    </path>
                </svg>
            </button>

            <div id="included-trip-content"></div></div></div>
{included.map(item=>{const text=item.text;return <template id={`included-template-${item.trip.id}`}><div class="flex flex-col p-6 md:p-8 gap-8">
                <div class="flex flex-col gap-4">
                    <div
                        class="relative w-full h-[55vh] md:h-[520px] bg-gray-900 overflow-hidden rounded-2xl shadow-2xl group">
                        <Image data-field="included-trip-modal-hero-img" src={imageAssets[item.gallery[0]]} alt={m.detailLabels.heroAlt} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" widths={[600,1200]} sizes="(min-width:1024px) 800px, 100vw"/>
                        <span data-field="included-trip-badge"
                            class="absolute top-4 right-4 z-20 inline-block bg-gold text-black font-bold text-[10px] px-2 py-1 rounded-sm uppercase tracking-widest shadow-lg" style={!item.trip.source[`badge_${locale}`]?'display:none':undefined}>{item.trip.source[`badge_${locale}`]}</span>
                    </div>
                    <div data-field="included-trip-modal-gallery" class="flex gap-3 overflow-x-auto pb-2 hide-scrollbar snap-x"><PackageGallery gallery={item.gallery} small/></div>
                    <div class="flex flex-col gap-2">
                        <div class="flex items-center gap-4 text-xs text-gold uppercase tracking-wider font-bold">
                            <div class="flex items-center">
                                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <span data-field="included-trip-duration" set:html={text.duration}></span>
                            </div>
                        </div>
                        <h2 data-field="included-trip-title"
                            class="text-2xl md:text-3xl font-playfair font-bold text-white leading-tight" set:html={text.title}></h2>
                    </div>
                </div>
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    <div class="space-y-10">

                        <!-- Description -->
                        <div class="prose prose-lg prose-invert max-w-none">
                            <p data-field="included-trip-desc" class="text-gray-300 leading-relaxed text-lg" set:html={text.short_desc}></p>
                        </div>

                        <div>
                            <h3 class="text-2xl font-playfair text-gold mb-6 border-b border-gray-800 pb-2"
                                data-i18n="global.highlights">{copy("global.highlights")}</h3>
                            <ul data-field="included-trip-highlights" class="space-y-3 text-gray-300 bullet-gold pl-4 text-lg" set:html={listHtml(text.highlights)}></ul>
                        </div>
                        <div>
                            <h3 class="text-2xl font-playfair text-white mb-6 border-b border-gray-800 pb-2"
                                data-i18n="global.included">{copy("global.included")}</h3>
                            <ul data-field="included-trip-includes" class="space-y-3 text-gray-300 bullet-gold pl-4 text-lg" set:html={listHtml(text.includes,true,'check')}></ul>
                        </div>
                        <div>
                            <h3 class="text-2xl font-playfair text-white mb-6 border-b border-gray-800 pb-2"
                                data-i18n="global.not_included">{copy("global.not_included")}</h3>
                            <ul data-field="included-trip-excludes" class="space-y-3 text-gray-400 bullet-gold pl-4 text-lg" set:html={listHtml(text.not_included,true,'cross')}></ul>
                        </div>
                        <div class="bg-gray-800/30 p-8 rounded-xl border border-gray-800">
                            <h3 class="text-2xl font-playfair text-white mb-6" data-i18n="global.itinerary_details">{copy("global.itinerary_details")}</h3>
                            <div data-field="included-trip-full-desc" class="text-gray-400 mb-6 leading-relaxed" set:html={text.full_description}></div>
                            <div data-field="included-trip-program" class="space-y-6 pt-6 border-t border-gray-700" set:html={modalProgramHtml(text.program)}></div>
                        </div>

                        <!-- Important -->
                        <div class="bg-red-900/10 border border-red-900/30 p-6 rounded-lg">
                            <h4 class="text-red-400 font-bold mb-3 text-lg flex items-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z">
                                    </path>
                                </svg>
                                <span data-i18n="global.important">{copy("global.important")}</span>
                            </h4>
                            <p data-field="included-trip-important" class="text-gray-400" set:html={text.important_notes}></p>
                        </div>
                    </div>
                </div>
            </div></template>;})}
