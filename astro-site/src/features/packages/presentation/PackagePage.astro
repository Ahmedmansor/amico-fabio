---
import type {Locale} from '../../../shared/config/languages';
import {getSharedMessages} from '../../../shared/i18n/shared';
import ProductDetail from '../../../shared/components/catalog/ProductDetail.astro';
import ProductGallery from '../../../shared/components/catalog/ProductGallery.astro';
import BookingForm from '../../booking/presentation/BookingForm.astro';
import InvoiceModal from '../../booking/presentation/InvoiceModal.astro';
import type {BookingAddon} from '../../booking/domain/booking';
import {calculateTotal} from '../../booking/domain/booking';
import FavoriteButton from '../../wishlist/presentation/FavoriteButton.astro';
import Faq from '../../../shared/components/Faq.astro';
import {imageAssets} from './images';
import {breakdownHtml,listHtml} from './markup';
import type {PackagePage} from '../domain/details';
import {editorialBadgeKey} from '../../../shared/domain/offers';
import IncludedTrips from './IncludedTrips.astro';
import IncludedTripModal from './IncludedTripModal.astro';
interface Props {page:PackagePage;addons:BookingAddon[]}
const {page,addons}=Astro.props,trip=page.package,text=page.text,locale=page.locale as Locale;
const m=getSharedMessages(locale);
// Included experiences are already validated members of this package.
const galleryPaths=[...new Set([...page.gallery,...page.included.flatMap(item=>item.gallery)])];
const initialTotal=calculateTotal({adults:trip.minPax,children:0,selectedAddons:[]},{...trip.prices,minPax:trip.minPax},addons);
const badge=m.global.badges[editorialBadgeKey(trip.source.badge_key) as keyof typeof m.global.badges]||'';
---
<ProductDetail locale={locale} title={text.title} duration={text.duration} adultPrice={trip.prices.adult} minPax={trip.minPax} bookLabel={m.global.book_package_now} badge={badge}>
  <Fragment slot="favorite"><FavoriteButton id={trip.id} kind="package" locale={locale} title={text.title} compact={false}/></Fragment>
  <ProductGallery slot="gallery" locale={locale} title={text.title} images={galleryPaths.map(src=>imageAssets[src])}/>
  <p slot="description" id="detail-desc" set:html={text.short_desc}></p>
  <ul slot="highlights" id="detail-highlights" class="product-list" set:html={listHtml(text.highlights)}></ul>
  <ul slot="includes" id="detail-includes" class="product-list product-included" set:html={listHtml(text.includes,true,'check')}></ul>
  <ul slot="excludes" id="detail-excludes" class="product-list product-excluded" set:html={listHtml(text.not_included,true,'cross')}></ul>
  <Fragment slot="itinerary">
    <div id="detail-full-desc" class="product-prose" set:html={text.full_description}></div>
    <div id="detail-program" class="product-program">{text.program.map((step,index)=><details class="product-step" open={index===0}><summary><span class="product-step-number">{index+1}</span><span><small>{step.time}</small><strong>{step.activity}</strong></span><span class="product-step-toggle" aria-hidden="true">+</span></summary><p>{step.details}</p></details>)}</div>
  </Fragment>
  <Fragment slot="included-trips"><p id="included-trips-subtitle">{page.included.length?m.packageLabels.includedSubtitle:''}</p><div id="included-trips-grid" class="product-included-trips"><IncludedTrips included={page.included} locale={locale}/></div></Fragment>
  <p slot="important" id="detail-important" set:html={text.important_notes}></p>
  <div slot="breakdown" id="card-price-breakdown" class="product-price-breakdown" set:html={breakdownHtml(trip,m.global.pricing.min_pax)}></div>
  <Fragment slot="booking">
    <BookingForm trip={trip} locale={locale} addons={addons} messages={m} kind="package"/>
    <div class="product-total"><span>{m.global.total_estimate}</span><strong id="live-total-price">€{initialTotal}</strong></div>
    <button id="btn-submit-booking" type="button" class="product-book-button">{m.global.book_package_now}</button>
  </Fragment>
  <Faq slot="faq" locale={locale}/>
</ProductDetail>
<InvoiceModal locale={locale}/>
<IncludedTripModal included={page.included} locale={locale}/>
<script>import './interactions';</script>
