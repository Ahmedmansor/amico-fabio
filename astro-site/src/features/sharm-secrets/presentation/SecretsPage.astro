---
import {Image,getImage} from 'astro:assets';
import type {GuidePage} from '../domain/secrets';
import {guideIndex} from '../domain/secrets';
import {guideImage} from './assets';
import GuideCard from './GuideCard.astro';
import squareLogo from '../../../shared/assets/logos/logo-fabio-square.webp';
import './secrets.css';
interface Props {page:GuidePage}
const {page}=Astro.props;
const m=page.content;
const backgrounds=await Promise.all(['section-hero','section-2','section-3','section-4','section-5','section-6'].map(name=>{
  const image=guideImage(`/assets/images/10-comandamenti-images/secrets-bg/${name}.webp`);
  return getImage({src:image,width:Math.min(image.width,1600)});
}));
const background=(index:number)=>`--bg-image:url("${backgrounds[index].src}")`;
const fullGallery=await Promise.all(m.page6.items.map(item=>{const image=guideImage(item.img);return getImage({src:image,width:image.width});}));
---
<main class="sharm-app">
  <section id="page1" class="section section-hero section-1" style={background(0)}><div class="section-backdrop"></div>
    <div class="section-inner section-inner-hero" style="opacity:1;visibility:visible;transform:none">
      <h1 class="section-title">{m.page1.headline}</h1><p class="section-subtitle">{m.page1.subtitle}</p><p class="section-body">{m.page1.content}</p>
      <figure class="hero-figure"><Image src={guideImage(m.page1.hero_img)} alt={page.labels.heroAlt} class="hero-photo" fetchpriority="high" loading="eager" widths={[600,1000]} sizes="(min-width:1024px) 600px, 100vw"/></figure>
      <p class="section-subtitle hero-extra-title">{m.page1.extra_title}</p><p class="section-body hero-extra-desc">{m.page1.extra_desc}</p>
    </div>
  </section>
  <section id="page2" class="section section-dynamic section-2" style={background(1)}><div class="section-backdrop"></div><div class="section-inner sharm-reveal">
    <h2 class="section-title sharm-reveal delay-100">{m.page2.headline}</h2><p class="section-intro sharm-reveal delay-200">{m.page2.intro}</p>
    <div id="servicesFlow" class="catalog-flow">{m.page2.services.map((item,index)=><GuideCard item={item} index={index}/>)}</div>
  </div></section>
  <section id="page3" class="section section-dynamic section-3" style={background(2)}><div class="section-backdrop"></div><div class="section-inner sharm-reveal">
    <h2 class="section-title section-title-shimmer sharm-reveal delay-100">{m.page3.headline}</h2><p class="section-intro sharm-reveal delay-200">{m.page3.intro}</p>
    <div id="rules-page3" class="catalog-flow">{m.page3.rules.map((item,index)=><GuideCard item={item} index={index}/>)}</div>
  </div></section>
  <section id="page4" class="section section-advice section-4" style={background(3)}><div class="section-backdrop"></div><div class="section-inner section-inner-narrow">
    <div class="golden-alert sharm-reveal"><p class="golden-alert-text">{m.page4.alert}</p></div><div class="checklist sharm-reveal delay-100">
      <h3 class="checklist-title">{m.page4.list_title}</h3><p class="checklist-intro">{m.page4.intro}</p>
      <div id="packing-checklist" class="checklist-items">{m.page4.items.map((item,index)=><div class="checklist-item sharm-reveal" style={`animation-delay:${index*70}ms`}><div class="checklist-icon"><i class={`fa-solid ${item.icon} checklist-icon-glyph`} aria-hidden="true"></i></div><div class="checklist-text"><h4>{item.title}</h4><p>{item.desc}</p></div></div>)}</div>
    </div>
  </div></section>
  <section id="page5" class="section section-farsha section-5" style={background(4)}><div class="section-backdrop"></div><div class="section-inner section-inner-bottom sharm-reveal">
    <div class="golden-alert sharm-reveal delay-100"><p class="golden-alert-text">{m.page5.alert}</p></div><p class="farsha-highlight">{m.page5.highlight}</p><p class="farsha-body">{m.page5.body}</p><p class="farsha-closing">{m.page5.closing}</p>
    <figure class="farsha-figure sharm-reveal delay-200"><Image src={guideImage(m.page5.img)} alt={page.labels.farshaAlt} class="farsha-photo" loading="lazy" decoding="async" widths={[600,1000]} sizes="(min-width:1024px) 600px, 100vw"/></figure>
  </div></section>
  <section id="page6" class="section section-adventures section-6" style={background(5)}><div class="section-backdrop"></div><div class="section-inner section-inner-adventures">
    <h2 class="section-title">{m.page6.title}</h2><p class="checklist-intro">{m.page6.intro}</p>
    <div class="adventures-scroll"><div id="adventuresGrid" class="adventures-track hide-scrollbar">
      {m.page6.items.map((item,index)=><div class="adventure-slide"><button type="button" class="adventure-card sharm-reveal" data-index={index} data-gallery-src={fullGallery[index].src} style={`animation-delay:${index*80}ms`}>
        <Image src={guideImage(item.img)} class="adventure-photo" alt="" loading="lazy" decoding="async" widths={[400,800]} sizes="320px"/><div class="adventure-caption">{item.cap}</div>
      </button></div>)}
    </div></div>
    <div class="footer-logo-wrap"><div class="footer-logo-card"><Image src={squareLogo} alt={page.labels.logoAlt} class="footer-logo-img" loading="lazy" widths={[360,720]} sizes="360px"/></div></div>
  </div></section>
</main>
<div id="gh-fab-wrapper" class="fab-wrap gh-wrap"><button type="button" id="secrets-index-toggle" class="fab-base gh-fab" aria-label={m.nav_index} aria-controls="indexMenu" aria-expanded="false"><svg viewBox="0 0 24 24" width="26" height="26" fill="#111" aria-hidden="true"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm3.5 6.5l-2 5-5 2 2-5 5-2z"/></svg></button><div class="gh-fab-label">{m.nav_index}</div></div>
<div id="indexMenu" class="index-menu" inert><div class="index-menu-inner"><button type="button" class="index-menu-close" aria-label={page.labels.closeIndex}>×</button><nav class="index-menu-nav">{guideIndex(m).map(item=><a class="index-link" href={`#${item.id}`}>{item.label}</a>)}</nav></div></div>
<div id="adventuresModal" class="adventures-modal" inert><div class="adventures-modal-inner"><button type="button" class="adventures-modal-close" aria-label={page.labels.closeGallery}>×</button><img id="adventuresModalImage" class="adventures-modal-image" alt=""/><div id="adventuresModalCaption" class="adventures-modal-caption"></div></div></div>
<script>import './secrets-interactions';</script>
