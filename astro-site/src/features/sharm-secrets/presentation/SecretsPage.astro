---
import GuideText from './GuideText.astro';
import {Image,getImage} from 'astro:assets';
import type {GuidePage} from '../domain/secrets';
import {guideIndex} from '../domain/secrets';
import {guideImage} from './assets';
import GuideCard from './GuideCard.astro';
import squareLogo from '../../../shared/assets/logos/logo-fabio-square.webp';
import './secrets.css';
import type {Locale} from '../../../shared/config/languages';
import RotationControl from '../../../shared/components/RotationControl.astro';
interface Props {page:GuidePage;locale:Locale}
const {page,locale}=Astro.props;
const m=page.content;
const fullGallery=await Promise.all(m.page6.items.map(item=>{const image=guideImage(item.img);return getImage({src:image,width:image.width});}));
---
<main class="sharm-app">
  <section id="page1" class="section section-hero section-1">
    <div class="section-inner section-inner-hero" style="opacity:1;visibility:visible;transform:none">
      <h1 class="section-title"><GuideText text={m.page1.headline}/></h1><p class="section-subtitle"><GuideText text={m.page1.subtitle}/></p><p class="section-body"><GuideText text={m.page1.content}/></p>
      <figure class="hero-figure"><Image src={guideImage(m.page1.hero_img)} alt={page.labels.heroAlt} class="hero-photo" fetchpriority="high" loading="eager" widths={[600,1000]} sizes="(min-width:1024px) 600px, 100vw"/></figure>
      <p class="section-subtitle hero-extra-title"><GuideText text={m.page1.extra_title}/></p><p class="section-body hero-extra-desc"><GuideText text={m.page1.extra_desc}/></p>
    </div>
  </section>
  <section id="page2" class="section section-dynamic section-2"><div class="section-inner sharm-reveal">
    <h2 class="section-title sharm-reveal delay-100"><GuideText text={m.page2.headline}/></h2><p class="section-intro sharm-reveal delay-200"><GuideText text={m.page2.intro}/></p>
    <div id="servicesFlow" class="catalog-flow">{m.page2.services.map((item,index)=><GuideCard item={item} index={index}/>)}</div>
  </div></section>
  <section id="page3" class="section section-dynamic section-3"><div class="section-inner sharm-reveal">
    <h2 class="section-title section-title-shimmer sharm-reveal delay-100"><GuideText text={m.page3.headline}/></h2><p class="section-intro sharm-reveal delay-200"><GuideText text={m.page3.intro}/></p>
    <div id="rules-page3" class="catalog-flow">{m.page3.rules.map((item,index)=><GuideCard item={item} index={index}/>)}</div>
  </div></section>
  <section id="page4" class="section section-advice section-4"><div class="section-inner section-inner-narrow">
    <div class="golden-alert sharm-reveal"><p class="golden-alert-text"><GuideText text={m.page4.alert}/></p></div><div class="checklist sharm-reveal delay-100">
      <h3 class="checklist-title"><GuideText text={m.page4.list_title}/></h3><p class="checklist-intro"><GuideText text={m.page4.intro}/></p>
      <div id="packing-checklist" class="checklist-items">{m.page4.items.map((item,index)=><div class="checklist-item sharm-reveal" style={`animation-delay:${index*70}ms`}><div class="checklist-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></div><div class="checklist-text"><h4><GuideText text={item.title}/></h4><p><GuideText text={item.desc}/></p></div></div>)}</div>
    </div>
  </div></section>
  <section id="page5" class="section section-farsha section-5"><div class="section-inner section-inner-bottom sharm-reveal">
    <div class="golden-alert sharm-reveal delay-100"><p class="golden-alert-text"><GuideText text={m.page5.alert}/></p></div><p class="farsha-highlight"><GuideText text={m.page5.highlight}/></p><p class="farsha-body"><GuideText text={m.page5.body}/></p><p class="farsha-closing"><GuideText text={m.page5.closing}/></p>
    <figure class="farsha-figure sharm-reveal delay-200"><Image src={guideImage(m.page5.img)} alt={page.labels.farshaAlt} class="farsha-photo" loading="lazy" decoding="async" widths={[600,1000]} sizes="(min-width:1024px) 600px, 100vw"/></figure>
  </div></section>
  <section id="page6" class="section section-adventures section-6"><div class="section-inner section-inner-adventures">
    <h2 class="section-title"><GuideText text={m.page6.title}/></h2><p class="checklist-intro"><GuideText text={m.page6.intro}/></p>
    <div class="guide-gallery-controls"><RotationControl locale={locale} target="adventuresGrid"/></div><div class="adventures-scroll"><div id="adventuresGrid" class="adventures-track hide-scrollbar">
      {m.page6.items.map((item,index)=><div class="adventure-slide"><button type="button" class="adventure-card sharm-reveal" data-index={index} data-gallery-src={fullGallery[index].src} style={`animation-delay:${index*80}ms`}>
        <Image src={guideImage(item.img)} class="adventure-photo" alt="" loading="lazy" decoding="async" widths={[400,800]} sizes="320px"/><div class="adventure-caption"><GuideText text={item.cap}/></div>
      </button></div>)}
    </div></div>
    <div class="footer-logo-wrap"><div class="footer-logo-card"><Image src={squareLogo} alt={page.labels.logoAlt} class="footer-logo-img" loading="lazy" widths={[360,720]} sizes="360px"/></div></div>
  </div></section>
</main>
<div id="gh-fab-wrapper" class="fab-wrap gh-wrap"><button type="button" id="secrets-index-toggle" class="fab-base gh-fab" aria-label={m.nav_index} aria-controls="indexMenu" aria-expanded="false"><span class="guide-index-icon"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m16 8-2.5 5.5L8 16l2.5-5.5L16 8Z"/></svg></span><span class="guide-index-label"><GuideText text={m.nav_index}/></span></button></div>
<dialog id="indexMenu" class="index-menu" aria-label={m.nav_index}><div class="index-menu-inner"><header class="index-toolbar"><h2><GuideText text={m.nav_index}/></h2><button type="button" class="index-menu-close" aria-label={page.labels.closeIndex}>×</button></header><nav class="index-menu-nav">{guideIndex(m).map(item=><a class="index-link" href={`#${item.id}`}><GuideText text={item.label}/></a>)}</nav></div></dialog>
<dialog id="adventuresModal" class="adventures-modal" aria-label={m.page6.title}><div class="adventures-modal-inner"><button type="button" class="adventures-modal-close" aria-label={page.labels.closeGallery}>×</button><img id="adventuresModalImage" class="adventures-modal-image" alt=""/><div id="adventuresModalCaption" class="adventures-modal-caption"></div></div></dialog>
<script>import './secrets-interactions';</script>
