---
import BaseLayout from '../../../shared/layouts/BaseLayout.astro';
import CatalogStructuredData from '../../../shared/seo/CatalogStructuredData.astro';
import {catalogPlainText} from '../../../shared/domain/catalog-seo';
import TripPage from '../../../features/tours/presentation/TripPage.astro';
import CatalogRedirect from '../../../shared/components/CatalogRedirect.astro';
import {catalogSlug,catalogPath,catalogAlternates,catalogSection} from '../../../shared/domain/catalog-routes';
import {supportedLocales} from '../../../shared/config/languages';
import type {Locale} from '../../../shared/config/languages';
import {getShareImage} from '../../../shared/seo/share-image';
import {imageAssets} from '../../../features/tours/presentation/images';
import type {TourPage as DetailPage} from '../domain/details';
import type {BookingAddon} from '../../booking/domain/booking';
interface Props {page:DetailPage;addons:BookingAddon[];redirect:boolean}
const {page,addons,redirect}=Astro.props;const locale=page.locale as Locale;
const slug=catalogSlug(page.trip,locale);
const alternatePaths=catalogAlternates(page.trip,supportedLocales,'tours');
const shareImage=await getShareImage(imageAssets[page.trip.poster],page.text.title);
---
{redirect?<CatalogRedirect destination={catalogPath(page.trip,locale,'tours')} title={catalogPlainText(page.text.title)} locale={locale} description={catalogPlainText(page.text.short_desc)} shareImage={shareImage}/>:<BaseLayout alternatePaths={alternatePaths} locale={locale} route={`${catalogSection(locale,'tours')}/${slug}`} title={`${catalogPlainText(page.text.title)} | Fabio Egypt`} description={catalogPlainText(page.text.short_desc)} shareImage={shareImage} keywords={page.text.seo_tags.join(', ')} bodyClass="font-sans antialiased text-gray-200 details-page"><CatalogStructuredData slot="head-start" image={shareImage} product={{kind:'tour',locale,slug,title:page.text.title,description:page.text.short_desc,adultPrice:page.trip.prices.adult,program:page.text.program}}/><TripPage page={page} addons={addons}/></BaseLayout>}
