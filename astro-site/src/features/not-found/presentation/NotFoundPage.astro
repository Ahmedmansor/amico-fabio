---
import DocumentShell from '../../../shared/layouts/DocumentShell.astro';
import {defaultLocale,languages} from '../../../shared/config/languages';
import type {getNotFoundMessages} from '../data/messages';
import '../../../shared/styles/global.css';
interface Props {messages:ReturnType<typeof getNotFoundMessages>}
const {messages}=Astro.props;
---
<DocumentShell locale={defaultLocale}>
 <Fragment slot="head"><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex, follow"/><title>404 | Fabio Egypt</title></Fragment>
 <main class="min-h-screen bg-black text-white flex items-center justify-center px-6 py-16">
  <div class="w-full max-w-3xl"><h1 class="text-6xl font-bold text-[#d4af37] mb-10">404</h1>
   <div class="grid gap-10 md:grid-cols-2">{messages.map(({locale,text})=><section lang={locale} dir={languages[locale].direction}><h2 class="text-2xl font-bold mb-3">{text.title}</h2><p class="text-gray-300 mb-6">{text.description}</p><nav class="flex flex-col gap-3"><a class="text-[#d4af37] underline" href={`/${locale}/`}>{text.home}</a><a class="text-[#d4af37] underline" href={`/${locale}/explore/`}>{text.tours}</a></nav></section>)}</div>
  </div>
 </main>
</DocumentShell>
